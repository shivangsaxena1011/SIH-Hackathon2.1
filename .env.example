# SENTINEL — SIH Hackathon Demo Environment Variables (Placeholder Template)
# NOTE: The platform is 100% self-contained and offline-resilient. No external API keys are required for judging.

NODE_ENV=production
PORT=3000

# Optional Demo Flags (Default: true)
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_SYNTHETIC_DATA=true

# Security Session Configuration
JWT_SECRET_KEY=demo-synthetic-jwt-secret-for-sih-presentation-only
SESSION_EXPIRY_HOURS=24
